#!/usr/bin/env bash
#
# serve — run cratis.no locally.
#
#   ./serve            → http://localhost:4321
#   ./serve 8080       → http://localhost:8080
#
# The site is plain static files with no build step, so any static server
# works. This picks the first one available and gets out of the way.

set -euo pipefail

PORT="${1:-4321}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
URL="http://localhost:${PORT}"

cd "$ROOT"

if lsof -i ":${PORT}" >/dev/null 2>&1; then
    echo "Port ${PORT} is already in use."
    echo "Stop it with:  lsof -ti :${PORT} | xargs kill"
    echo "Or pick another port:  ./serve 4322"
    exit 1
fi

echo "cratis.no  →  ${URL}"
echo "Ctrl-C to stop."
echo

# Open a browser once the server is actually accepting connections, so the
# first load never races the startup.
(
    for _ in $(seq 1 50); do
        if curl -sf -o /dev/null "${URL}/" 2>/dev/null; then
            command -v open >/dev/null 2>&1 && open "${URL}"
            break
        fi
        sleep 0.1
    done
) &

if command -v python3 >/dev/null 2>&1; then
    exec python3 -m http.server "$PORT" --bind 127.0.0.1
elif command -v npx >/dev/null 2>&1; then
    exec npx --yes serve --listen "$PORT" .
elif command -v php >/dev/null 2>&1; then
    exec php -S "127.0.0.1:${PORT}"
elif command -v ruby >/dev/null 2>&1; then
    exec ruby -run -e httpd . -p "$PORT" -b 127.0.0.1
else
    echo "No static server found. Install one of: python3, node (npx), php, ruby." >&2
    exit 1
fi
